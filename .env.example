# ---------- Browser (bundled into the site — public by design) ----------
# Firebase web config (console.firebase.google.com > Project settings > Your apps)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ---------- Server only (Vercel > Settings > Environment Variables) ----------
# NEVER prefix these with VITE_ — anything starting with VITE_ is shipped to the browser.
# Hugging Face token (huggingface.co/settings/tokens) with permission to call Inference Providers
HF_TOKEN=hf_your_huggingface_token_here

# Optional: AI rate limits (defaults shown)
# AI_LIMIT_PER_MINUTE=4
# AI_LIMIT_PER_DAY=30
# AI_LIMIT_GLOBAL_DAY=500
# Optional: shared rate-limit store (Upstash Redis / Vercel KV). Without it limits are per instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
